// XOR of numbers from 0 to n
ll xor0n(ll n) {
    if (n % 4 == 0) return n;
    if (n % 4 == 1) return 1;
    if (n % 4 == 2) return n + 1;
    return 0;
}

// XOR of range [l, r], assuming l >= 0
ll rangeXor(ll l, ll r) {
    return xor0n(r) ^ (l == 0 ? 0 : xor0n(l - 1));
}

// Check power of two
bool isPowerOfTwo(ll n) {


#include <bits/stdc++.h>
using namespace std;

using ull = uint32_t;


// =====================================================
// 1. STRING TRIE: INSERT, SEARCH, STARTS WITH
// =====================================================

const int N1 = 1000005;

int trie1[N1][26];
bool terminal1[N1];
int node1 = 0;


// INSERT
void insertString(string s) {

    int cur = 0;

    for (char c : s) {

        int x = c - 'a';

        if (trie1[cur][x] == 0) {
            trie1[cur][x] = ++node1;
        }

        cur = trie1[cur][x];
    }

    terminal1[cur] = true;
}


// SEARCH
bool searchString(string s) {

    int cur = 0;

    for (char c : s) {

        int x = c - 'a';

        if (trie1[cur][x] == 0) {
            return false;
        }

        cur = trie1[cur][x];
    }

    return terminal1[cur];
}


// STARTS WITH
bool startsWith(string s) {

    int cur = 0;

    for (char c : s) {

        int x = c - 'a';

        if (trie1[cur][x] == 0) {
            return false;
        }

        cur = trie1[cur][x];
    }

    return true;
}


// =====================================================
// 2. STRING TRIE: COUNT WORDS AND PREFIXES
// =====================================================

const int N2 = 1000005;

int trie2[N2][26];
int pref[N2], endd[N2];
int node2 = 0;


// INSERT
void insertCount(string s) {

    int cur = 0;

    for (char c : s) {

        int x = c - 'a';

        if (trie2[cur][x] == 0) {
            trie2[cur][x] = ++node2;
        }

        cur = trie2[cur][x];

        pref[cur]++;
    }

    endd[cur]++;
}


// COUNT WORDS EQUAL TO STRING
int countWordsEqualTo(string s) {

    int cur = 0;

    for (char c : s) {

        int x = c - 'a';

        if (trie2[cur][x] == 0) {
            return 0;
        }

        cur = trie2[cur][x];
    }

    return endd[cur];
}


// COUNT WORDS STARTING WITH STRING
int countWordsStartingWith(string s) {

    int cur = 0;

    for (char c : s) {

        int x = c - 'a';

        if (trie2[cur][x] == 0) {
            return 0;
        }

        cur = trie2[cur][x];
    }

    return pref[cur];
}


// =====================================================
// 3. TRIE: COUNT ALL DISTINCT SUBSTRINGS
// =====================================================

const int N3 = 1000005;

int trie3[N3][26];
int node3 = 0;


// INSERT SUFFIX
void insertSuffix(string &s, int start) {

    int cur = 0;

    for (int i = start; i < s.size(); i++) {

        int x = s[i] - 'a';

        if (trie3[cur][x] == 0) {
            trie3[cur][x] = ++node3;
        }

        cur = trie3[cur][x];
    }
}


// COUNT DISTINCT SUBSTRINGS
int distinctSubstrings(string s) {

    for (int i = 0; i < s.size(); i++) {
        insertSuffix(s, i);
    }

    return node3;
}


// =====================================================
// 4. BINARY TRIE: MAXIMUM XOR
// =====================================================

const int N4 = 3200005;

int trie4[N4][2];
int node4 = 0;


// INSERT
void insertBinary(ull x) {

    int cur = 0;

    for (int i = 31; i >= 0; i--) {

        int bit = (x >> i) & 1u;

        if (trie4[cur][bit] == 0) {
            trie4[cur][bit] = ++node4;
        }

        cur = trie4[cur][bit];
    }
}


// MAXIMUM XOR
ull getMaxXor(ull x) {

    int cur = 0;
    ull ans = 0;

    for (int i = 31; i >= 0; i--) {

        int bit = (x >> i) & 1u;
        int opposite = 1 - bit;

        if (trie4[cur][opposite] != 0) {

            ans |= (1u << i);

            cur = trie4[cur][opposite];
        }

        else {

            cur = trie4[cur][bit];
        }
    }

    return ans;
}


// =====================================================
// 5. BINARY TRIE: DUPLICATES, SEARCH AND DELETE
// =====================================================

const int N5 = 3200005;

int trie5[N5][2];
int cnt5[N5];

int node5 = 0;


// INSERT
void insertWithCount(ull x) {

    int cur = 0;

    cnt5[cur]++;

    for (int i = 31; i >= 0; i--) {

        int bit = (x >> i) & 1u;

        if (trie5[cur][bit] == 0) {
            trie5[cur][bit] = ++node5;
        }

        cur = trie5[cur][bit];

        cnt5[cur]++;
    }
}


// SEARCH
bool searchBinary(ull x) {

    int cur = 0;

    for (int i = 31; i >= 0; i--) {

        int bit = (x >> i) & 1u;

        if (trie5[cur][bit] == 0 ||
            cnt5[trie5[cur][bit]] == 0) {

            return false;
        }

        cur = trie5[cur][bit];
    }

    return cnt5[cur] > 0;
}


// DELETE
bool eraseBinary(ull x) {

    if (!searchBinary(x)) {
        return false;
    }

    int cur = 0;

    cnt5[cur]--;

    for (int i = 31; i >= 0; i--) {

        int bit = (x >> i) & 1u;

        cur = trie5[cur][bit];

        cnt5[cur]--;
    }

    return true;
}


// MAXIMUM XOR WITH ACTIVE ELEMENTS
ull getMaxXorWithCount(ull x) {

    if (cnt5[0] == 0) {
        return 0;
    }

    int cur = 0;
    ull ans = 0;

    for (int i = 31; i >= 0; i--) {

        int bit = (x >> i) & 1u;
        int opposite = 1 - bit;

        if (trie5[cur][opposite] != 0 &&
            cnt5[trie5[cur][opposite]] > 0) {

            ans |= (1u << i);

            cur = trie5[cur][opposite];
        }

        else {

            cur = trie5[cur][bit];
        }
    }

    return ans;
}


// =====================================================
// MAIN FUNCTION: TEST ANY TEMPLATE
// =====================================================

int main() {

    // 1. STRING TRIE

    insertString("apple");
    insertString("app");

    cout << searchString("apple") << '\n';
    cout << startsWith("appl") << '\n';


    // 2. COUNTING TRIE

    insertCount("apple");
    insertCount("app");
    insertCount("apple");

    cout << countWordsEqualTo("apple") << '\n';
    cout << countWordsStartingWith("app") << '\n';


    // 3. DISTINCT SUBSTRINGS

    cout << distinctSubstrings("aba") << '\n';


    // 4. MAXIMUM XOR

    insertBinary(5);
    insertBinary(7);

    cout << getMaxXor(3) << '\n';


    // 5. BINARY TRIE WITH DUPLICATES

    insertWithCount(5);
    insertWithCount(5);
    insertWithCount(7);

    cout << searchBinary(5) << '\n';

    cout << getMaxXorWithCount(3) << '\n';

    cout << eraseBinary(5) << '\n';
    cout << eraseBinary(10) << '\n';

    cout << searchBinary(5) << '\n';


    return 0;
}

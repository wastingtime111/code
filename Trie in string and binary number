1.Making a tier of a strings and do 3 operations insert,search and startswith in the tier
    #include <bits/stdc++.h>
    using namespace std;

    const int N = 1000005;

    int trie[N][26];
    bool terminal[N];
    int node = 0;

    void insert(string s) {
        int cur = 0;

        for (char c : s) {
            int x = c - 'a';

            if (trie[cur][x] == 0) {
                trie[cur][x] = ++node;
            }

            cur = trie[cur][x];
        }

        terminal[cur] = true;
    }

    bool search(string s) {
        int cur = 0;

        for (char c : s) {
            int x = c - 'a';

            if (trie[cur][x] == 0) {
                return false;
            }

            cur = trie[cur][x];
        }

        return terminal[cur];
    }

    bool startsWith(string s) {
        int cur = 0;

        for (char c : s) {
            int x = c - 'a';

            if (trie[cur][x] == 0) {
                return false;
            }

            cur = trie[cur][x];
        }

        return true;
    }

    int main() {
        insert("apple");
        insert("app");

        cout << search("apple") << '\n';    // 1
        cout << search("appl") << '\n';     // 0
        cout << startsWith("appl") << '\n'; // 1
    }







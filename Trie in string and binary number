4. trie in bits

    const int N = 1000005;
    int trie[N][2];
    int node = 0;

    void insert(int x) {
        int cur = 0;

        for (int i = 30; i >= 0; i--) {

            int bit = (x >> i) & 1;

            if (trie[cur][bit] == 0) {
                trie[cur][bit] = ++node;
            }

            cur = trie[cur][bit];
        }
    }

    int getMaxXor(int x) {

        int cur = 0;
        int ans = 0;

        for (int i = 30; i >= 0; i--) {

            int bit = (x >> i) & 1;

            int opposite = 1 - bit;

            if (trie[cur][opposite] != 0) {

                ans |= (1 << i);

                cur = trie[cur][opposite];
            }
            else {

                cur = trie[cur][bit];
            }
        }

        return ans;
    }

        int main() {

            int n;
            cin >> n;

            vector<int> a(n);

            for (int i = 0; i < n; i++) {
                cin >> a[i];
            }

            int ans = 0;

            insert(a[0]);

            for (int i = 1; i < n; i++) {

                ans = max(ans, getMaxXor(a[i])); //compare then insert in this manner repeated comparison will not going to happend

                insert(a[i]);
            }

            cout << ans << '\n';

            return 0;
        }

            void bfs(int src, vector<vector<int>>& adj) {
                queue<pair<int, int>> q;
                q.push({src, 0}); // node, parent

                while (!q.empty()) {
                    auto [u, p] = q.front();
                    q.pop();

                    cout << u << " ";

                    for (int v : adj[u]) {
                        if (v == p) continue;
                        q.push({v, u});
                    }
                }
            }
        
        bfs on grid:
            void bfs(int sx, int sy, vector<string>& grid,
            vector<vector<int>>& dist) {

                int n = grid.size();
                int m = grid[0].size();

                queue<pair<int, int>> q;
                q.push({sx, sy});
                dist[sx][sy] = 0;

                int dx[] = {-1, 1, 0, 0};
                int dy[] = {0, 0, -1, 1};

                while (!q.empty()) {
                    auto [x, y] = q.front();
                    q.pop();

                    for (int i = 0; i < 4; i++) {
                        int nx = x + dx[i];
                        int ny = y + dy[i];

                        if (nx < 0 || nx >= n ||
                            ny < 0 || ny >= m)
                            continue;

                        if (grid[nx][ny] == '#' || dist[nx][ny] != -1)
                            continue;

                        dist[nx][ny] = dist[x][y] + 1;
                        q.push({nx, ny});
                    }
                }
            }

                    

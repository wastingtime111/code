        Diameter of a tree:
            #include <bits/stdc++.h>
            using namespace std;

            using ll = long long;

            pair<int, int> dfs(int src, vector<vector<int>>& adj) {
                int n = adj.size();
                vector<int> dist(n, -1);
                stack<int> st;

                st.push(src);
                dist[src] = 0;

                int farthest = src;

                while (!st.empty()) {
                    int u = st.top();
                    st.pop();

                    if (dist[u] > dist[farthest])
                        farthest = u;

                    for (int v : adj[u]) {
                        if (dist[v] == -1) {
                            dist[v] = dist[u] + 1;
                            st.push(v);
                        }
                    }
                }

                return {farthest, dist[farthest]};
            }

            int main() {
                int n;
                cin >> n;

                vector<vector<int>> adj(n + 1);

                for (int i = 0; i < n - 1; i++) {
                    int u, v;
                    cin >> u >> v;

                    adj[u].push_back(v);
                    adj[v].push_back(u);
                }

                int A = dfs(1, adj).first;
                int diameter = dfs(A, adj).second;

                cout << diameter << '\n';

                return 0;
            }
    


